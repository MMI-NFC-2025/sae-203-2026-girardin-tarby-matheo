---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section
        class="bg-white py-12 px-6 min-h-screen flex flex-col items-center md:grid md:grid-cols-10 md:gap-8"
    >
        <div class="w-full max-w-2xl">
            <h1
                class="text-[#FF9800] text-5xl md:text-6xl font-bold text-center mb-12 italic"
            >
                Contact
            </h1>

            <form action="#" method="POST" class="flex flex-col gap-6">
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="flex-1">
                        <label
                            for="nom"
                            class="block text-[#7A4B1A] font-bold text-xl mb-2 ml-4"
                            >Nom</label
                        >
                        <input
                            type="text"
                            id="nom"
                            name="nom"
                            class="w-full bg-[#FFBD6F] border-none rounded-[30px] py-4 px-6 focus:ring-2 focus:ring-[#7A4B1A] outline-none"
                        />
                    </div>
                    <div class="flex-1">
                        <label
                            for="prenom"
                            class="block text-[#7A4B1A] font-bold text-xl mb-2 ml-4"
                            >Prénom</label
                        >
                        <input
                            type="text"
                            id="prenom"
                            name="prenom"
                            class="w-full bg-[#FFBD6F] border-none rounded-[30px] py-4 px-6 focus:ring-2 focus:ring-[#7A4B1A] outline-none"
                        />
                    </div>
                </div>

                <div>
                    <label
                        for="email"
                        class="block text-[#7A4B1A] font-bold text-xl mb-2 ml-4"
                        >Email</label
                    >
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="w-full bg-[#FFBD6F] border-none rounded-[30px] py-4 px-6 focus:ring-2 focus:ring-[#7A4B1A] outline-none"
                    />
                </div>

                <div>
                    <label
                        for="message"
                        class="block text-[#7A4B1A] font-bold text-xl mb-2 ml-4"
                        >Message</label
                    >
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        class="w-full bg-[#FFBD6F] border-none rounded-[30px] py-4 px-6 focus:ring-2 focus:ring-[#7A4B1A] outline-none resize-none"
                    ></textarea>
                </div>

                <div class="flex justify-center mt-4">
                    <button
                        type="submit"
                        class="bg-[#7A4B1A] text-white font-bold py-3 px-12 rounded-full hover:scale-105 transition-transform cursor-pointer"
                    >
                        Envoyer
                    </button>
                </div>
            </form>
        </div>
    </section>
</Layout>
