---
import Layout from "../layouts/Layout.astro";
import CardArtiste from "../components/CardArtiste.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/img/hero.avif";
import DownArrow from "../assets/icone/down_arrow.svg";
import Partenaire1 from "../assets/img/partenaire1.avif";
import Partenaire2 from "../assets/img/partenaire2.avif";
import Partenaire3 from "../assets/img/partenaire3.avif";

---

<Layout>
    <!-- Hero Section -->
    <section
        class="relative min-h-screen flex flex-col items-center justify-center text-center text-white overflow-hidden"
    >
        <!-- Background Image -->
        <div class="absolute inset-0 z-0">
            <Image
                src={heroImg}
                alt="Festival background"
                class="w-full h-full object-cover"
                loading="eager"
            />
            <div class="absolute inset-0 bg-black/50"></div>
        </div>

        <!-- Hero Content -->
        <div class="relative z-10 px-6 py-16 flex flex-col items-center gap-6">
            <h1
                class="text-4xl md:text-6xl lg:text-7xl font-bold text-primary drop-shadow-lg"
            >
                La Fanfa'comtoise
            </h1>
            <h2 class="text-xl md:text-2xl lg:text-3xl text-white">
                Jazz, Fanfare, Bonne humeur
            </h2>
            <p class="text-lg md:text-xl text-white/90 mt-4">
                Du 27 au 28 Juin 2026
            </p>
            <p class="text-2xl md:text-3xl font-bold text-white">
                A Montbeliard
            </p>

            <!-- Countdown -->
            <div class="flex gap-4 md:gap-8 mt-8 text-center">
                <div
                    class="flex flex-col items-center bg-black/40 rounded-lg px-4 py-3 md:px-6 md:py-4"
                >
                    <span
                        id="days"
                        class="text-3xl md:text-5xl font-bold text-primary"
                        >000</span
                    >
                    <span class="text-sm md:text-base text-white/80">Jours</span
                    >
                </div>
                <span
                    class="text-3xl md:text-5xl font-bold text-primary self-center"
                    >:</span
                >
                <div
                    class="flex flex-col items-center bg-black/40 rounded-lg px-4 py-3 md:px-6 md:py-4"
                >
                    <span
                        id="hours"
                        class="text-3xl md:text-5xl font-bold text-primary"
                        >00</span
                    >
                    <span class="text-sm md:text-base text-white/80"
                        >Heures</span
                    >
                </div>
                <span
                    class="text-3xl md:text-5xl font-bold text-primary self-center"
                    >:</span
                >
                <div
                    class="flex flex-col items-center bg-black/40 rounded-lg px-4 py-3 md:px-6 md:py-4"
                >
                    <span
                        id="minutes"
                        class="text-3xl md:text-5xl font-bold text-primary"
                        >00</span
                    >
                    <span class="text-sm md:text-base text-white/80"
                        >Minutes</span
                    >
                </div>
            </div>

            <!-- Billetterie Button -->
            <a
                href="#billetterie"
                class="mt-8 bg-primary-dark hover:bg-primary text-white font-bold py-3 px-10 rounded-full transition-colors text-lg md:text-xl"
            >
                Billetterie
            </a>
        </div>

        <!-- Scroll Down Arrow -->
        <div
            class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce"
        >
            <a
                href="#programmation"
                class="text-white/80 hover:text-white transition-colors"
            >
                <DownArrow class="w-8 h-8 md:w-10 md:h-10" />
            </a>
        </div>
    </section>

    <!-- Section "Vous voulez en savoir plus ?" -->
    <section class="bg-primary py-16 px-6">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-secondary-dark text-3xl md:text-4xl font-bold mb-6">
                Vous voulez en savoir plus ?
            </h2>
            <p
                class="text-black/80 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto"
            >
                Decouvrez la programmation complete, les artistes, les scenes et
                toutes les informations pratiques pour profiter au maximum du
                festival La Fanfa'comtoise !
            </p>
            <div class="flex flex-wrap justify-center gap-4 mt-8">
                <a
                    href="/artiste"
                    class="bg-secondary-dark hover:bg-primary-dark text-white font-bold py-3 px-8 rounded-full transition-colors"
                >
                    Voir les artistes
                </a>
                <a
                    href="/scene"
                    class="bg-white hover:bg-gray-100 text-secondary-dark font-bold py-3 px-8 rounded-full transition-colors border-2 border-secondary-dark"
                >
                    Decouvrir les scenes
                </a>
            </div>
        </div>
    </section>

    <CardArtiste />

    <!-- Partenaires Section -->
    <section class="py-16 px-6">
        <div class="max-w-6xl mx-auto">
            <h2
                class="text-secondary-dark text-3xl md:text-4xl font-bold text-center mb-12"
            >
                Nos Partenaires
            </h2>

            <div
                class="flex flex-wrap justify-center items-center gap-8 md:gap-16"
            >
                <div
                    class="bg-white p-6 h-50 rounded-xl shadow-md hover:shadow-lg transition-shadow"
                >
                    <Image src={Partenaire1.src} alt="Partenaire 1" class="mt-8 w-74.4 h-auto md:w-74 md:h-auto" />

                </div>
                <div
                    class="bg-white p-6 h-50 rounded-xl shadow-md hover:shadow-lg transition-shadow"
                >
                    <Image src={Partenaire2.src} alt="Partenaire 2" class="w-74.4 h-auto md:w-74 md:h-auto" />
                </div>
                <div
                    class="bg-white p-6 h-50 rounded-xl shadow-md hover:shadow-lg transition-shadow"
                >
                    <Image src={Partenaire3.src} alt="Partenaire 3" class="w-74.4 h-auto md:w-74 md:h-auto" />
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    // Countdown Timer
    function updateCountdown() {
        const festivalDate = new Date("2026-06-27T00:18:00").getTime();
        const now = new Date().getTime();
        const difference = festivalDate - now;

        if (difference > 0) {
            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor(
                (difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
            );
            const minutes = Math.floor(
                (difference % (1000 * 60 * 60)) / (1000 * 60),
            );

            const daysEl = document.getElementById("days");
            const hoursEl = document.getElementById("hours");
            const minutesEl = document.getElementById("minutes");

            if (daysEl) daysEl.textContent = days.toString().padStart(3, "0");
            if (hoursEl)
                hoursEl.textContent = hours.toString().padStart(2, "0");
            if (minutesEl)
                minutesEl.textContent = minutes.toString().padStart(2, "0");
        }
    }

    updateCountdown();
    setInterval(updateCountdown, 60000); // Update every minute
</script>
