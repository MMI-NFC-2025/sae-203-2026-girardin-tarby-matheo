---
import CardScene from "../../components/CardScene.astro";
import Layout from "../../layouts/Layout.astro";
import { scenesName } from "../../../backend/backend.mjs";

const scenes = await scenesName();
---

<Layout title="Scènes">
    <section id="scenes" class="bg-white py-20 px-6">
        <div class="max-w-6xl mx-auto">
            <h1
                class="text-primary-dark text-4xl md:text-5xl font-extrabold text-center mb-16"
            >
                Nos Scènes
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
                {
                    scenes.map((scene) => (
                        <div class="md:col-span-6">
                            <CardScene scene={scene} />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
