---
import Layout from "../../layouts/Layout.astro";
import { artistesSorted } from "../../../backend/backend.mjs";
import CardArtiste from "../../components/CardArtiste.astro";

const artistes = await artistesSorted();

const artistesClient = artistes.map((a) => ({
    ...a,
    expand: {
        scene: a.expand?.scene ? { ...a.expand.scene } : null,
    },
}));

const scenes = Array.from(
    new Set(artistes.map((a) => a.expand?.scene?.nom).filter(Boolean)),
);

const genres = Array.from(
    new Set(artistes.map((a) => a.genre_musical).filter(Boolean)),
);
---

<Layout title="Artistes">
    <section class="bg-white py-16 px-6 min-h-screen">
        <div class="max-w-7xl mx-auto">
            <h2
                class="text-primary-dark text-4xl md:text-5xl font-extrabold text-center mb-16"
            >
                Programmation
            </h2>
            <div class="bg-primary p-6 rounded-2xl shadow-md mb-12">
                <h2 class="text-secondary-dark font-bold text-2xl mb-4">
                    Filtrer la programmation
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
                    <div>
                        <label class="block text-[#7A4B1A] font-bold mb-2"
                            >Scène</label
                        >
                        <select
                            id="filterScene"
                            class="w-full bg-[#FFBD6F] rounded-xl py-3 px-4 outline-none"
                        >
                            <option value="all">Toutes les scènes</option>
                            {scenes.map((s) => <option value={s}>{s}</option>)}
                        </select>
                    </div>
                    <div>
                        <label class="block text-[#7A4B1A] font-bold mb-2">
                            Genre musical
                        </label>
                        <select
                            id="filterGenre"
                            class="w-full bg-[#FFBD6F] rounded-xl py-3 px-4 outline-none"
                        >
                            <option value="all">Tous les genres</option>
                            {genres.map((g) => <option value={g}>{g}</option>)}
                        </select>
                    </div>
                    <div>
                        <label class="block text-[#7A4B1A] font-bold mb-2"
                            >Jour</label
                        >
                        <select
                            id="filterDate"
                            class="w-full bg-[#FFBD6F] rounded-xl py-3 px-4 outline-none"
                        >
                            <option value="all">Tous les jours</option>
                            <option value="27">27 Juin</option>
                            <option value="28">28 Juin</option>
                        </select>
                    </div>
                    <div class="flex md:justify-end">
                        <button
                            id="applyFilters"
                            class="w-full md:w-auto bg-secondary-dark text-white font-bold py-3 px-6 rounded-xl"
                        >
                            Appliquer
                        </button>
                    </div>
                </div>
            </div>
            <div
                id="artistesContainer"
                class="grid grid-cols-12 gap-8"
                data-artistes={JSON.stringify(artistesClient)}
            >
                <CardArtiste artistes={artistesClient} />
            </div>
        </div>
    </section>
</Layout>

<script>
    const container = document.getElementById("artistesContainer");
    const artistes = JSON.parse(container.dataset.artistes);

    const filterScene = document.getElementById("filterScene");
    const filterGenre = document.getElementById("filterGenre");
    const filterDate = document.getElementById("filterDate");
    const applyBtn = document.getElementById("applyFilters");

    function formatDate(dateStr) {
        const d = new Date(dateStr);
        return d.toLocaleDateString("fr-FR", {
            day: "2-digit",
            month: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
        });
    }

    function renderArtistes(list) {
        container.innerHTML = "";

        list.forEach((a) => {
            const wrapper = document.createElement("div");
            wrapper.className = "col-span-12 sm:col-span-6 lg:col-span-4";

            const imgUrl = a.image_principale
                ? `https://fanfa-comtoise.girardin-tarby.fr/api/files/${a.collectionId}/${a.id}/${a.image_principale}`
                : "";

            wrapper.innerHTML = `
        <article class="bg-primary rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
          <div class="aspect-video relative">
            ${
                imgUrl
                    ? `<img src="${imgUrl}" class="absolute inset-0 w-full h-full object-cover" />`
                    : ""
            }
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-4 left-4 text-white">
              <span class="bg-secondary-dark px-3 py-1 rounded-full text-sm font-bold">
                ${formatDate(a.debut)}
              </span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold text-secondary-dark">${a.nom}</h3>
            <p class="mt-2">
              <span class="inline-block bg-secondary-dark/20 text-secondary-dark px-2 py-1 rounded-md text-xs font-bold">
                ${a.expand?.scene?.nom ?? "Scène inconnue"}
              </span>
            </p>
            <p class="text-black/50 text-sm italic mt-2">${a.genre_musical ?? ""}</p>
            <a href="/artiste/${a.id}" class="inline-block mt-4 text-secondary-dark font-bold hover:underline">
              En savoir plus →
            </a>
          </div>
        </article>
      `;

            container.appendChild(wrapper);
        });
    }

    function applyFilters() {
        let filtered = [...artistes];

        if (filterScene.value !== "all") {
            filtered = filtered.filter(
                (a) => a.expand?.scene?.nom === filterScene.value,
            );
        }

        if (filterGenre.value !== "all") {
            filtered = filtered.filter(
                (a) => a.genre_musical === filterGenre.value,
            );
        }

        if (filterDate.value !== "all") {
            filtered = filtered.filter(
                (a) =>
                    new Date(a.debut).getDate().toString() === filterDate.value,
            );
        }

        renderArtistes(filtered);
    }

    renderArtistes(artistes);
    applyBtn.addEventListener("click", applyFilters);
</script>
