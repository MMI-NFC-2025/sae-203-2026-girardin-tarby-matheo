---
import MenuOpen from "../assets/icone/menu-open1.svg";
import MenuClose from "../assets/icone/menu_cross.svg";
import HeaderLogo from "../assets/icone/header_img.svg";

let isOpen = false;
---

<header class="w-full bg-primary px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
        <HeaderLogo class="w-full h-full" />
    </a>

    <!-- Bouton menu mobile -->
    <button
        id="menu-btn"
        class="md:hidden w-10 h-10 flex items-center justify-center"
        aria-label="Ouvrir le menu"
    >
        <MenuOpen />
    </button>

    <!-- Menu desktop -->
    <nav class="hidden md:flex gap-8 text-black font-family text-2xl">
        <a href="/festival">Le festival</a>
        <a href="/artiste">Programmation</a>
        <a href="/scenes">Les scènes</a>
        <a href="/infos">Infos pratiques</a>
    </nav>
</header>

<!-- Menu mobile -->
<div
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-full bg-primary shadow-xl transform translate-x-full transition-transform duration-300 z-100 flex flex-col pl-10 pr-10 py-3 gap-20 text-xl font-medium"
>
    <ul class="flex flex-row items-center justify-between">
        <li>
            <a href="/" class="flex items-center gap-2">
                <HeaderLogo class="w-auto h-auto" />
            </a>
        </li>
        <li>
            <button id="close-btn" class="w-8 h-8 self-end">
                <MenuClose />
            </button>
        </li>
    </ul>

    <div class="w-full relative">
        <ul class="w-fit relative flex flex-col gap-10">
            <li>
                <a href="/festival" class="text-black font-family text-4xl">
                    Le festival
                </a>
            </li>
            <li>
                <a href="/artiste" class="text-black font-family text-4xl">
                    Programmation
                </a>
            </li>
            <li>
                <a href="/scenes" class="text-black font-family text-4xl">
                    Les scènes
                </a>
            </li>
            <li>
                <a href="/infos" class="text-black font-family text-4xl"
                    >Infos pratiques</a
                >
            </li>
        </ul>
    </div>
</div>

<script>
    const btn = document.getElementById("menu-btn");
    const closeBtn = document.getElementById("close-btn");
    const menu = document.getElementById("mobile-menu");

    btn.addEventListener("click", () => {
        menu.classList.remove("translate-x-full");
    });

    closeBtn.addEventListener("click", () => {
        menu.classList.add("translate-x-full");
    });
</script>
