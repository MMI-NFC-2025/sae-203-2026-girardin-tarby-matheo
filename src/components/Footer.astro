---
import { Image } from "astro:assets";

import facebook from "../assets/icone/facebook.svg";
import instagram from "../assets/icone/instagram.svg";
import twitter from "../assets/icone/twitter.svg";
import youtube from "../assets/icone/youtube.svg";
import Footer_img from "../assets/icone/footer_img.svg";
---

<footer class="bg-primary pt-12 pb-4 px-6">
    <div class="max-w-6xl mx-auto flex flex-col items-center">
        <nav
            class="flex flex-col md:flex-row md:justify-between md:items-end gap-8 w-full"
        >
            <div class="flex-1 w-full">
                <a
                    href="/a-propos"
                    class="text-2xl md:text-3xl font-bold text-black block mb-2 hover:opacity-70 transition-opacity"
                >
                    A propos
                </a>
                <div class="h-[2px] bg-black w-full"></div>
            </div>

            <div class="flex-1 w-full">
                <a
                    href="/contact"
                    class="text-2xl md:text-3xl font-bold text-black block mb-2 hover:opacity-70 transition-opacity"
                >
                    Contact
                </a>
                <div class="h-[2px] bg-black w-full"></div>
            </div>

            <div class="flex-1 w-full">
                <a
                    href="/infos-pratiques"
                    class="text-2xl md:text-3xl font-bold text-black block mb-2 hover:opacity-70 transition-opacity"
                >
                    Infos Pratiques
                </a>
                <div class="h-[2px] bg-black w-full"></div>
            </div>
        </nav>

        <div
            class="w-full flex flex-col md:flex-row md:justify-between md:items-center mt-12 gap-8"
        >
            <div class="flex justify-center md:justify-start gap-6 lg:gap-10">
                <a href="#" class="hover:scale-110 transition-transform">
                    <img src={instagram.src} alt="Instagram" class="w-8 h-8" />
                </a>
                <a href="#" class="hover:scale-110 transition-transform">
                    <img src={facebook.src} alt="Facebook" class="w-8 h-8" />
                </a>
                <a href="#" class="hover:scale-110 transition-transform">
                    <img src={twitter.src} alt="Twitter" class="w-8 h-8" />
                </a>
                <a href="#" class="hover:scale-110 transition-transform">
                    <img src={youtube.src} alt="YouTube" class="w-8 h-8" />
                </a>
            </div>

            <div class="flex justify-center md:justify-end">
                <img
                    src={Footer_img.src}
                    alt="Trompette"
                    class="w-40 md:w-56 lg:w-64 h-auto object-contain"
                />
            </div>
        </div>

        <p class="text-xs text-black/60 mt-8 w-full text-center md:text-left">
            © 2026 - SAE 203 Girardin Tarby Mathéo
        </p>
    </div>
</footer>
